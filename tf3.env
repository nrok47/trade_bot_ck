# ============================================================
# Binance Trend-Following Grid Bot — TF=3m Profile
# cp .env.example_tf3 .env  แล้วกรอกค่าจริง
# ห้าม commit .env ขึ้น git เด็ดขาด!
# ============================================================
# ปรับมาจาก .env.example สำหรับ TF=3m โดยเฉพาะ
# Backtest 7d: Net +24.94%, MaxDD 0.96%, 145 resets, 162 fills
# ============================================================

# --- Binance API ---
BINANCE_API_KEY=wg2saQAAmnxxCLYsHZfPrKMtIovlzJ8S9nykKGwzvvmsvwERqLIeuS3QeyAFBzkV
BINANCE_API_SECRET=EYXy51rhEJLahShimvFXBjmxNTvJT16TyL2Nyb2qTJXhdHw0RcjM7QFgQZxAd6ib

# --- Market ---
MARKET=futures

# --- เหรียญ ---
SYMBOL=XRPUSDT

# --- ช่วงราคา Grid (ใช้ AUTO_RANGE=true แทนการตั้งมือ) ---
UPPER_PRICE=2.30
LOWER_PRICE=1.70

# Grid count: 10 grids → spacing แคบลง fill บ่อยขึ้น
GRID_COUNT=10

# Margin ต่อ grid ($2 × 10 = $20 ทุนรวม)
USDT_PER_GRID=2.0

# --- Futures ---
LEVERAGE=10
MARGIN_TYPE=ISOLATED

# ============================================================
# Trend-Following Settings — ปรับสำหรับ TF=3m
# ============================================================

# TF=3m: ตอบสนองเร็ว เทรดบ่อย เหมาะกับตลาดที่ขยับเร็ว
TIMEFRAME=3m

# EMA periods — เหมือนเดิม (9/21 ทำงานดีกับ 3m)
EMA_SHORT=9
EMA_LONG=21

RSI_PERIOD=14

# EMA gap: 0.1% — เท่าเดิม ป้องกัน noise cross
EMA_MIN_GAP_PCT=0.1

GRID_MODE=trend

# ============================================================
# Whipsaw Protection — ปรับสำหรับ TF=3m
# ============================================================

# 3 bars = ต้องเห็น signal เดิม 3 candles (= 9 นาที) ก่อน reset
# สำคัญมากสำหรับ TF=3m เพื่อกรอง noise
TREND_CONFIRM_BARS=3

# รอ 1 candle (3 นาที) ขั้นต่ำก่อน reset ได้อีกครั้ง
MIN_RESET_INTERVAL_SECONDS=180

# ============================================================
# Stop Loss per Grid
# ============================================================

STOP_LOSS_PCT=0

# ============================================================
# Dynamic Range Management
# ============================================================

AUTO_REGRID=true
REGRID_THRESHOLD=0.25
HOLD_POSITION_ON_RESET=true

# เปิด AUTO_RANGE เพื่อให้บอทคำนวณกรอบอัตโนมัติตอนเริ่ม
AUTO_RANGE=true
RANGE_STRATEGY=lookback

ATR_PERIOD=14
ATR_MULTIPLIER=2.0

BB_PERIOD=20
BB_STD=2.0

# 480 × 3m = 24h  ← สำคัญ! ต้องใช้ 480 สำหรับ TF=3m (ไม่ใช่ 288)
LOOKBACK_BARS=480
BUFFER_PCT=0.05

PRICE_ALERT_PCT=3.0
AUTO_STOP_PCT=5.0

# ============================================================
# Proxy
# ============================================================
PROXY_URL=

# ============================================================
# Telegram Notifications (optional)
# ============================================================
TELEGRAM_BOT_TOKEN=8737634544:AAH4J_GN6ZEhDVhGwntGQnYidmUmI8FzpvM
TELEGRAM_CHAT_ID=912600110

# ============================================================
# Safety & Profit Target
# ============================================================

DRY_RUN=true

# เป้ากำไร/วัน: backtest ได้ ~25% ใน 7 วัน ≈ 3.5%/วัน
# ตั้งไว้ที่ 5% เผื่อวันดี (= $1/วัน จากทุน $20)
DAILY_PROFIT_TARGET_PCT=13

# ยอมขาดทุนสูงสุด/วัน (สมมาตรกับ profit target)
MAX_LOSS_PCT=13

POLL_INTERVAL_SECONDS=5
