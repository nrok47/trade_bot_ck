# ============================================================
# Binance Trend-Following Grid Bot — Environment Variables
# cp .env.example .env  แล้วกรอกค่าจริง
# ห้าม commit .env ขึ้น git เด็ดขาด!
# ============================================================
#
# ── Recommended config (ผ่าน backtest 90 วัน) ────────────────
#   SYMBOL=XRPUSDT | TF=5m | 8 grids × $2.5 | CDC 20/50
#   Net +1230% / 90d  |  Max DD 22%  |  Win rate 51.5%
# ─────────────────────────────────────────────────────────────

# --- Binance API ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Market ---
# "spot" = Spot wallet  |  "futures" = USDT-M Futures
MARKET=futures

# --- เหรียญ ---
# ✅ XRPUSDT, DOGEUSDT, ADAUSDT → notional ~$12-20/order พอดีกับ min $5
# ❌ BTCUSDT, ETHUSDT → min order สูงเกินสำหรับทุน $20
SYMBOL=XRPUSDT

# --- ช่วงราคา Grid (ใช้เมื่อ AUTO_RANGE=false) ---
# ดูราคาปัจจุบันแล้วตั้ง ±15%  เช่น XRP=$1.43 → Lower=1.20, Upper=1.70
# เมื่อ AUTO_RANGE=true ค่านี้ถูก override อัตโนมัติ
UPPER_PRICE=1.70
LOWER_PRICE=1.20

# Grid count: backtest พบว่า 8 grids ให้ balance ดีที่สุด
# น้อย (6) = กำไร/fill สูงกว่า แต่ fill น้อยกว่า
# มาก (12) = fill บ่อยขึ้น แต่กำไร/fill เล็กลง + fee รวมมากขึ้น
GRID_COUNT=8

# Margin ต่อ grid (ทุนรวม = USDT_PER_GRID × GRID_COUNT)
# $2.5 × 8 = $20  |  Notional/grid = $2.5 × 5x = $12.5
USDT_PER_GRID=2.5

# --- Futures ---
# แนะนำ 3–5x เท่านั้น สำหรับ grid bot (สูงกว่านี้เสี่ยง liquidate)
LEVERAGE=5
MARGIN_TYPE=ISOLATED

# ============================================================
# Signal Mode — เลือกวิธี detect trend
# ============================================================

# "ema"  = EMA crossover + RSI + Bull/Bear Power (ดั้งเดิม)
# "cdc"  = CDC Action Zone by HAP — ดู position ของราคา vs FastEMA vs SlowEMA
#          backtest พบว่า CDC ให้ Max DD ต่ำกว่า EMA อย่างมีนัยสำคัญ
SIGNAL_MODE=cdc

# ── CDC Action Zone settings (ใช้เมื่อ SIGNAL_MODE=cdc) ──────
# fast=20, slow=50 → เปลี่ยน zone ช้า reset น้อยกว่า fast=12/slow=26
# fast=12, slow=26 → ตอบสนองเร็วกว่า แต่ reset บ่อยกว่า
CDC_FAST=20
CDC_SLOW=50

# CDC_STRICT=true  → BULL เฉพาะ zone1 (Price>Fast>Slow), BEAR เฉพาะ zone4
#                    ช่วง sideways วิ่ง BOTH mode → fills มากกว่า (แนะนำ)
# CDC_STRICT=false → BULL=zones1-3, BEAR=zones4-6 — ก้าวร้าวกว่า
CDC_STRICT=true

# ── EMA settings (ใช้เมื่อ SIGNAL_MODE=ema) ──────────────────
EMA_SHORT=9
EMA_LONG=21
RSI_PERIOD=14

# % ขั้นต่ำที่ EMA short ต้องห่างจาก EMA long ก่อนนับเป็น signal
# ป้องกัน noise cross ในช่วง sideways
EMA_MIN_GAP_PCT=0.1

# ============================================================
# Grid Direction Mode
# ============================================================

# "trend" = grid ตาม signal (LONG/SHORT/BOTH ตาม trend) ← แนะนำ
# "both"  = grid สองทางเสมอ ไม่สนใจ trend
GRID_MODE=trend

# ============================================================
# Timeframe
# ============================================================

# ตัวเลือก: 1m, 3m, 5m, 15m, 30m
# TF สั้น (3m/5m)  = fills บ่อย แต่ resets บ่อยด้วย
# TF ยาว (15m/30m) = นิ่งกว่า แต่ช้าตอบสนอง
# backtest พบว่า 5m ให้ balance ดีที่สุดสำหรับ XRP/DOGE
TIMEFRAME=5m

# ============================================================
# Whipsaw Protection (ป้องกัน reset บ่อยเกินไป)
# ============================================================

# จำนวน candle ที่ต้องเห็น signal เดิมติดต่อกันก่อนเปลี่ยน direction
# TF 5m: 2 bars = 10 นาที  |  3 bars = 15 นาที
# สูง = นิ่งกว่า แต่ Max DD สูงขึ้น (ตอบสนอง trend พลิกช้า) — ระวัง!
TREND_CONFIRM_BARS=2

# รอขั้นต่ำกี่วินาทีหลัง reset ก่อนจะ reset ได้อีกครั้ง
# TF 5m → แนะนำ 300 (resets ส่วนใหญ่ห่างกันเกิน 300s อยู่แล้ว)
MIN_RESET_INTERVAL_SECONDS=300

# ============================================================
# Stop Loss per Grid
# ============================================================

# % ต่ำกว่าราคา BUY ที่จะตัดขาดทุน (0 = ปิด feature)
# ตัวอย่าง: STOP_LOSS_PCT=3.0  BUY @$1.43 → SL @$1.387
# แนะนำ: 1.5–3x ของ grid spacing ถ้าจะเปิด
# สำหรับ grid bot ส่วนใหญ่ไม่จำเป็น เพราะ bot วาง BUY ใหม่ทุกระดับ
STOP_LOSS_PCT=0

# ============================================================
# Dynamic Range Management
# ============================================================

# AUTO_REGRID=true → re-center กรอบเมื่อราคาเลื่อนเข้าโซนขอบ
AUTO_REGRID=false
REGRID_THRESHOLD=0.25

# HOLD_POSITION_ON_RESET=true → เมื่อ trend เปลี่ยน ยกเลิกเฉพาะ pending orders
#   ไม่ force-close position → ประหยัด taker fee 0.04% ต่อ reset
#   ⚠ ความเสี่ยง: position เก่าขาดทุนเพิ่มได้ถ้า trend พลิกแรง
HOLD_POSITION_ON_RESET=true

# AUTO_RANGE=true → คำนวณ Upper/Lower อัตโนมัติ (ไม่ต้องตั้งมือ)
AUTO_RANGE=true

# กลยุทธ์คำนวณกรอบ:
#   "lookback" → High/Low จริงใน N bars ± buffer  ← แนะนำ
#   "atr"      → ± ATR × multiplier (ยุ่งยาก ต้องปรับตาม TF)
#   "bollinger" → Bollinger Bands
RANGE_STRATEGY=lookback

# ATR settings (ใช้เมื่อ RANGE_STRATEGY=atr)
ATR_PERIOD=14
ATR_MULTIPLIER=2.0

# Bollinger Bands settings (ใช้เมื่อ RANGE_STRATEGY=bollinger)
BB_PERIOD=20
BB_STD=2.0

# Lookback settings (ใช้เมื่อ RANGE_STRATEGY=lookback)
# 288 × 5m = 24h  |  96 × 15m = 24h  |  480 × 3m = 24h
LOOKBACK_BARS=288
BUFFER_PCT=0.05

# ── Boundary Alert & Auto-Stop ──
# แจ้งเตือนเมื่อราคาใกล้ขอบกรอบภายใน % นี้
PRICE_ALERT_PCT=3.0

# หยุดบอทอัตโนมัติเมื่อราคาหลุดกรอบออกไป % นี้
AUTO_STOP_PCT=5.0

# ============================================================
# Proxy — ถ้า server โดน Binance บล็อก "restricted location"
# ============================================================
# ตัวอย่าง HTTP:   PROXY_URL=http://user:pass@1.2.3.4:3128
# ตัวอย่าง SOCKS5: PROXY_URL=socks5://user:pass@1.2.3.4:1080
PROXY_URL=

# ============================================================
# Telegram Notifications (optional)
# ============================================================
# วิธีหา token: คุยกับ @BotFather ใน Telegram → /newbot
# วิธีหา chat_id: ส่งข้อความหา bot แล้วเปิด:
#   https://api.telegram.org/bot<TOKEN>/getUpdates  → ดูค่า "id" ใน "chat"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# Safety & Profit Target
# ============================================================

# DRY_RUN=true  = จำลอง ไม่ใช้เงินจริง ← เริ่มตรงนี้เสมอ!
# DRY_RUN=false = ส่ง order จริง
DRY_RUN=true

# เป้ากำไรต่อวัน (% ของทุน) — บอทหยุดเองเมื่อถึง
# 15% ของ $20 = $3 USDT ต่อวัน (อนุรักษ์นิยม)
# 33% ของ $20 = $6.60 USDT ต่อวัน (เชิงรุก)
DAILY_PROFIT_TARGET_PCT=15

# ยอมขาดทุนต่อวันได้กี่ % ของทุน
# backtest พบ Max DD ในวันที่แย่ที่สุดได้ถึง 22% (90 วัน)
# แนะนำ: 10–15% เพื่อไม่ให้หยุดบ่อยเกินไปในช่วง volatile
MAX_LOSS_PCT=15

# ตรวจสอบ order ทุกกี่วินาที
POLL_INTERVAL_SECONDS=5

# ============================================================
# Turbo Mode — ความเสี่ยงสูงสุด ความถี่สูงสุด
# ============================================================
# ใช้ python bot.py --turbo  (หรือตั้งที่นี่)
# Turbo จะ override: TF=3m, CDC non-strict, confirm-bars=1, min-reset=60s
# เพิ่มทั้งโอกาสกำไร และความเสี่ยง — resets จะถี่มากขึ้น
TURBO_MODE=false
# TF ที่ใช้ใน turbo mode: "1m" = เร็วที่สุด  "3m" = แนะนำ (balance ดีกว่า 1m)
TURBO_TIMEFRAME=3m

# ============================================================
# Session Mode — เทรดช่วงเวลาจำกัด
# ============================================================
# 0 = ทำงานไม่จำกัดเวลา (default)
# >0 = หยุดอัตโนมัติหลัง N นาที พร้อมสรุปผล
# หรือใช้ python bot.py --session 60  (ไม่ต้องแก้ไฟล์นี้)
# Session mode จะเริ่ม BOTH grid ทันที ไม่รอ trend signal
SESSION_DURATION_MINUTES=0
