# ============================================================
# Binance Grid Trading Bot — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- Binance API ---
# สร้าง API key ที่ binance.com → Profile → API Management
# Permission: Enable Reading + Enable Spot & Margin Trading (หรือ Enable Futures)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# --- Market Type ---
# "spot"    = เทรด Spot (ใช้ USDT ใน Spot wallet)
# "futures" = เทรด USDT-M Futures (ต้องเปิด Enable Futures ใน API key)
MARKET=spot

# --- Grid Settings ---
# คู่เหรียญที่จะเทรด
SYMBOL=BTCUSDT

# ช่วงราคาของ Grid (ตั้งให้ครอบคลุมราคาปัจจุบัน ±10-15%)
UPPER_PRICE=100000
LOWER_PRICE=80000

# จำนวน grid levels (แนะนำ 10-20)
GRID_COUNT=10

# USDT ต่อ 1 grid level
# Spot:    ใช้ USDT จริงๆ
# Futures: นี่คือ margin ต่อ grid (notional = USDT_PER_GRID × LEVERAGE)
USDT_PER_GRID=10.0

# --- Futures Only (ไม่ใช้ถ้า MARKET=spot) ---
# Leverage: 1 = ไม่ใช้ leverage, 2 = 2x, สูงสุด 125x (อันตราย!)
# แนะนำเริ่มที่ 1-3x เท่านั้น
LEVERAGE=1

# ISOLATED = จำกัด margin ต่อ position (ปลอดภัยกว่า)
# CROSSED  = ใช้ balance ทั้งหมดเป็น margin
MARGIN_TYPE=ISOLATED

# --- Safety ---
# DRY_RUN=true = แสดงผลอย่างเดียว ไม่ส่ง order จริง
DRY_RUN=true

# หยุดบอทถ้าขาดทุนเกินนี้ (USDT)
MAX_LOSS_USDT=50.0

# ตรวจสอบ order ทุกกี่วินาที
POLL_INTERVAL_SECONDS=5
