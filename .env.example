# ============================================================
# Binance Grid Trading Bot — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- Binance API ---
# สร้าง API key ที่ binance.com → Profile → API Management
# Permission ที่ต้องเปิด:
#   ✅ Enable Reading
#   ✅ Enable Spot & Margin Trading  (ถ้าใช้ MARKET=spot)
#   ✅ Enable Futures                (ถ้าใช้ MARKET=futures)
#   ❌ Enable Withdrawals            (ปิดเสมอ!)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# --- Market Type ---
# "spot"    = เทรด Spot ปกติ
# "futures" = เทรด USDT-M Futures (ต้องเปิด Enable Futures ใน API key)
MARKET=futures

# ============================================================
# ตัวอย่างสำหรับ ทุน $20 USDT + 5x Leverage
#
# ⚠  BTCUSDT ใช้ไม่ได้! (min order ~$90 เกินทุน)
#    ให้ใช้ XRPUSDT, DOGEUSDT, ADAUSDT แทน
#
# XRPUSDT (XRP ราคา ~$2):
#   GRID_COUNT=5, USDT_PER_GRID=4 → ทุนรวม $20
#   Notional/grid = $4 × 5x = $20 → ซื้อ XRP ได้ ~10 XRP/grid ✓
#
# DOGEUSDT (DOGE ราคา ~$0.15):
#   GRID_COUNT=5, USDT_PER_GRID=4 → ทุนรวม $20
#   Notional/grid = $4 × 5x = $20 → ซื้อ DOGE ได้ ~133 DOGE/grid ✓
# ============================================================

# --- Grid Settings ---
SYMBOL=XRPUSDT

# ช่วงราคา: ดูราคาปัจจุบันของ XRPUSDT แล้วตั้ง ±15%
# ถ้า XRP อยู่ที่ $2.00:
UPPER_PRICE=2.40
LOWER_PRICE=1.60

# จำนวน grid (5 levels เหมาะกับทุนน้อย ไม่ให้ notional ต่ำเกินไป)
GRID_COUNT=5

# Margin ต่อ grid (ทุนรวม = USDT_PER_GRID × GRID_COUNT = $4 × 5 = $20)
USDT_PER_GRID=4.0

# --- Futures Settings ---
# Leverage 5x → Notional จริงต่อ grid = $4 × 5 = $20
# ⚠  ถ้าราคาหลุดออกนอก grid ทั้งหมด อาจขาดทุน ~$20 ทั้งหมด
LEVERAGE=5
MARGIN_TYPE=ISOLATED

# --- DRY RUN (โหมดจำลอง) ---
# true  = จำลองเท่านั้น ดูผลโดยไม่ใช้เงินจริง  ← เริ่มตรงนี้ก่อนเสมอ!
# false = ส่ง order จริง ใช้เงินจริง
DRY_RUN=true

# หยุดบอทถ้าขาดทุนเกินนี้ (แนะนำตั้ง ≤ ทุนทั้งหมด)
MAX_LOSS_USDT=20.0

# ตรวจสอบ order ทุกกี่วินาที
POLL_INTERVAL_SECONDS=5
