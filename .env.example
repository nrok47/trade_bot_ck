# ============================================================
# Binance Grid Trading Bot — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- Binance API ---
# สร้าง API key ที่ binance.com → Profile → API Management
# Permission: Enable Spot & Margin Trading (ไม่ต้องเปิด Withdrawals)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# --- Grid Settings ---
# คู่เหรียญที่จะเทรด
SYMBOL=BTCUSDT

# ช่วงราคาของ Grid (ต้องตั้งตามราคาตลาดปัจจุบัน)
UPPER_PRICE=100000
LOWER_PRICE=80000

# จำนวน grid levels (ยิ่งเยอะ ยิ่งถี่ แต่กำไรต่อ trade น้อยลง)
GRID_COUNT=10

# USDT ต่อ 1 grid level
USDT_PER_GRID=10.0

# --- Safety ---
# DRY_RUN=true = แสดงผลอย่างเดียว ไม่ส่ง order จริง
DRY_RUN=true

# หยุดบอทถ้าขาดทุนเกินนี้ (USDT) ในรอบนั้น
MAX_LOSS_USDT=50.0

# ตรวจสอบ order ทุกกี่วินาที
POLL_INTERVAL_SECONDS=5
