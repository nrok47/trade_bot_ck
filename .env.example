# ============================================================
# Polymarket Arbitrage Bot — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- Wallet (Polygon) ---
# Private key of your Polygon wallet (with USDC)
PRIVATE_KEY=0xyour_private_key_here

# --- Polymarket API ---
# Get from https://polymarket.com  → Settings → API
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here
POLYMARKET_API_PASSPHRASE=your_passphrase_here

# --- Bot Settings ---
# DRY_RUN=true means scan only, NO real orders placed
DRY_RUN=true

# Minimum arbitrage profit per trade in USDC (after fees)
MIN_PROFIT_USDC=0.05

# Maximum USDC to spend per single arbitrage trade
MAX_TRADE_SIZE_USDC=10.0

# Maximum total USDC allowed in open positions at once
MAX_OPEN_POSITIONS_USDC=50.0

# Seconds between each market scan cycle
SCAN_INTERVAL_SECONDS=5

# Polymarket taker fee rate (currently 0% on most markets, set 0.02 for 2%)
TAKER_FEE_RATE=0.0
