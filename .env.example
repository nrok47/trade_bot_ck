# ============================================================
# Binance Trend-Following Grid Bot — Environment Variables
# cp .env.example .env  แล้วกรอกค่าจริง
# ห้าม commit .env ขึ้น git เด็ดขาด!
# ============================================================

# --- Binance API ---
BINANCE_API_KEY=key
BINANCE_API_SECRET=secret

# --- Market ---
# "spot" = Spot wallet  |  "futures" = USDT-M Futures
MARKET=futures

# --- เหรียญ (แนะนำสำหรับทุน $20) ---
# ❌ BTCUSDT → min order ~$90 เกินทุน
# ✅ XRPUSDT, DOGEUSDT, ADAUSDT → min order $5–10 พอดี
SYMBOL=XRPUSDT

# --- ช่วงราคา Grid ---
# ดูราคาปัจจุบันของ XRPUSDT แล้วตั้ง ±15%
# ตัวอย่าง: XRP = $2.00  →  Lower=$1.70, Upper=$2.30
UPPER_PRICE=2.30
LOWER_PRICE=1.70

# Grid count: น้อย = notional ต่อ grid สูง (ปลอดภัยกว่า)
GRID_COUNT=5

# Margin ต่อ grid (ทุนรวม = USDT_PER_GRID × GRID_COUNT)
# $4 × 5 = $20 พอดีกับทุนที่มี
USDT_PER_GRID=4.0

# --- Futures ---
# Leverage 5x → Notional/grid = $4 × 5 = $20
# แนะนำ 3–5x เท่านั้น สำหรับ grid bot
LEVERAGE=5
MARGIN_TYPE=ISOLATED

# ============================================================
# Trend-Following Settings
# ============================================================

# Timeframe สำหรับอ่าน candle และตรวจ trend
# ตัวเลือก: 1m, 3m, 5m, 15m, 30m
# สั้น (3m/5m)  = ตอบสนองเร็ว เทรดบ่อย แต่ผิดพลาดบ้าง
# ยาว (15m/30m) = signal นิ่งกว่า เทรดน้อยกว่า แต่แม่นขึ้น
TIMEFRAME=5m

# EMA periods (short ต้องน้อยกว่า long เสมอ)
EMA_SHORT=9
EMA_LONG=21

# RSI period
RSI_PERIOD=14

# Grid direction mode
# "trend" = grid ตาม bull/bear signal (แนะนำ)
# "both"  = grid สองทาง ไม่สนใจ trend
GRID_MODE=trend

# ============================================================
# Whipsaw Protection (ป้องกัน reset บ่อยเกินไปช่วง sideways)
# ============================================================

# จำนวน candle ที่ต้องเห็น signal เดิมติดต่อกันก่อนเปลี่ยน direction
# สูง = นิ่งกว่า, ต่ำ = ตอบสนองเร็วกว่า
# แนะนำ: TF 5m → 2,  TF 15m → 2,  TF 3m → 3
TREND_CONFIRM_BARS=2

# รอขั้นต่ำกี่วินาทีหลัง reset ก่อนจะ reset ได้อีกครั้ง
# แนะนำ: เท่ากับ 1 candle (5m=300, 15m=900, 3m=180)
MIN_RESET_INTERVAL_SECONDS=300

# ============================================================
# Dynamic Range Management (ATR-Based Auto Initialization)
# ============================================================

# AUTO_RANGE=true  → บอทคำนวณ Upper/Lower อัตโนมัติตอนเริ่ม (ไม่ต้องตั้งมือ)
# AUTO_RANGE=false → ใช้ค่า UPPER_PRICE / LOWER_PRICE จาก .env โดยตรง
AUTO_RANGE=false

# กลยุทธ์คำนวณกรอบ (ใช้เมื่อ AUTO_RANGE=true):
#   "atr"      → ±ATR_MULTIPLIER × ATR  ← แนะนำ
#   "bollinger" → Bollinger Bands ± buffer
#   "lookback" → High/Low ในรอบ LOOKBACK_BARS candle ± buffer
RANGE_STRATEGY=atr

# ATR settings (ใช้เมื่อ RANGE_STRATEGY=atr)
ATR_PERIOD=14
ATR_MULTIPLIER=2.0

# Bollinger Bands settings (ใช้เมื่อ RANGE_STRATEGY=bollinger)
BB_PERIOD=20
BB_STD=2.0

# Lookback settings (ใช้เมื่อ RANGE_STRATEGY=lookback)
# 96 × 15m = 24h  หรือ  96 × 5m = 8h
LOOKBACK_BARS=96
BUFFER_PCT=0.05

# ── Boundary Alert & Auto-Stop ──
# แจ้งเตือนเมื่อราคาใกล้ขอบกรอบภายใน % นี้ (default 3%)
PRICE_ALERT_PCT=3.0

# หยุดบอทอัตโนมัติเมื่อราคาหลุดกรอบออกไป % นี้ (default 5%)
AUTO_STOP_PCT=5.0

# ============================================================
# Telegram Notifications (optional)
# ============================================================

# วิธีหา token: คุยกับ @BotFather ใน Telegram → /newbot
# วิธีหา chat_id: ส่งข้อความหา bot แล้วเปิด:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
#   → ดูค่า "id" ใน "chat" object
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# Safety & Profit Target
# ============================================================

# DRY_RUN=true  = จำลอง ดูผลโดยไม่ใช้เงินจริง ← เริ่มตรงนี้!
# DRY_RUN=false = ส่ง order จริง ใช้เงินจริง
DRY_RUN=true

# เป้ากำไรต่อวัน (% ของทุน) — บอทหยุดเองเมื่อถึง
# 33% ของ $20 = $6.60 USDT ต่อวัน
DAILY_PROFIT_TARGET_PCT=33

# หยุดบอทถ้าขาดทุนเกินนี้ (USDT)
MAX_LOSS_USDT=20.0

# ตรวจสอบ order ทุกกี่วินาที
POLL_INTERVAL_SECONDS=5
