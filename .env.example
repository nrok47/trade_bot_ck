# ============================================================
# Binance Trend-Following Grid Bot — Environment Variables
# cp .env.example .env  แล้วกรอกค่าจริง
# ห้าม commit .env ขึ้น git เด็ดขาด!
# ============================================================

# --- Binance API ---
BINANCE_API_KEY=wg2saQAAmnxxCLYsHZfPrKMtIovlzJ8S9nykKGwzvvmsvwERqLIeuS3QeyAFBzkV
BINANCE_API_SECRET=EYXy51rhEJLahShimvFXBjmxNTvJT16TyL2Nyb2qTJXhdHw0RcjM7QFgQZxAd6ib

# --- Market ---
# "spot" = Spot wallet  |  "futures" = USDT-M Futures
MARKET=futures

# --- เหรียญ (แนะนำสำหรับทุน $20) ---
# ❌ BTCUSDT → min order ~$90 เกินทุน
# ✅ XRPUSDT, DOGEUSDT, ADAUSDT → min order $5–10 พอดี
SYMBOL=XRPUSDT

# --- ช่วงราคา Grid ---
# ดูราคาปัจจุบันของ XRPUSDT แล้วตั้ง ±15%
# ตัวอย่าง: XRP = $2.00  →  Lower=$1.70, Upper=$2.30
UPPER_PRICE=2.30
LOWER_PRICE=1.70

# Grid count: น้อย = notional ต่อ grid สูง (ปลอดภัยกว่า)
GRID_COUNT=5

# Margin ต่อ grid (ทุนรวม = USDT_PER_GRID × GRID_COUNT)
# $4 × 5 = $20 พอดีกับทุนที่มี
USDT_PER_GRID=4.0

# --- Futures ---
# Leverage 5x → Notional/grid = $4 × 5 = $20
# แนะนำ 3–5x เท่านั้น สำหรับ grid bot
LEVERAGE=5
MARGIN_TYPE=ISOLATED

# ============================================================
# Trend-Following Settings
# ============================================================

# Timeframe สำหรับอ่าน candle และตรวจ trend
# ตัวเลือก: 1m, 3m, 5m, 15m, 30m
# สั้น (3m/5m)  = ตอบสนองเร็ว เทรดบ่อย แต่ผิดพลาดบ้าง
# ยาว (15m/30m) = signal นิ่งกว่า เทรดน้อยกว่า แต่แม่นขึ้น
TIMEFRAME=5m

# EMA periods (short ต้องน้อยกว่า long เสมอ)
EMA_SHORT=9
EMA_LONG=21

# RSI period
RSI_PERIOD=14

# Grid direction mode
# "trend" = grid ตาม bull/bear signal (แนะนำ)
# "both"  = grid สองทาง ไม่สนใจ trend
GRID_MODE=trend

# ============================================================
# Safety & Profit Target
# ============================================================

# DRY_RUN=true  = จำลอง ดูผลโดยไม่ใช้เงินจริง ← เริ่มตรงนี้!
# DRY_RUN=false = ส่ง order จริง ใช้เงินจริง
DRY_RUN=true

# เป้ากำไรต่อวัน (% ของทุน) — บอทหยุดเองเมื่อถึง
# 33% ของ $20 = $6.60 USDT ต่อวัน
DAILY_PROFIT_TARGET_PCT=33

# หยุดบอทถ้าขาดทุนเกินนี้ (USDT)
MAX_LOSS_USDT=20.0

# ตรวจสอบ order ทุกกี่วินาที
POLL_INTERVAL_SECONDS=5
